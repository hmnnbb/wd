{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "C/C++: 构建当前文件 (gcc/g++)",
            "type": "shell",
            "command": "${workspaceFolder}\\.vscode\\build.bat",
            "args": [
                "${file}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "detail": "按扩展名自动选择：.c 用 gcc，.cpp/.cc/.cxx 用 g++。F5 调试与 Ctrl+Shift+B 都走这里。"
        },
        {
            "label": "C/C++: 运行当前文件 (集成终端)",
            "type": "shell",
            "command": "cmd",
            "args": [
                "/c",
                "\"${workspaceFolder}\\.vscode\\build.bat\" \"${file}\" && \"${fileDirname}\\${fileBasenameNoExtension}.exe\""
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true,
                "clear": true
            },
            "detail": "编译后在集成终端里直接运行：可以在终端里键入输入，程序结束后输出留在屏幕上，不会一闪而过。"
        },
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe 生成活动文件（仅 C++）",
            "command": "D:\\tools\\msys64\\ucrt64\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-fexec-charset=UTF-8",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "手动备用任务：只用来编译 .cpp。日常请直接用第一个任务。"
        },
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe 生成活动文件",
            "command": "D:\\tools\\msys64\\ucrt64\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "调试器生成的任务。"
        }
    ]
}